# ForgeLocal — Environment Variables
# Copy this file to .env.local and fill in real values
# Never commit .env.local to version control

# ─── Application ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ForgeLocal

# ─── Database — MongoDB ───────────────────────────────────────────────────────
# For local development: mongodb://localhost:27017/forgelocal
# For MongoDB Atlas:     mongodb+srv://<user>:<password>@<cluster>.mongodb.net/forgelocal
MONGODB_URI=mongodb://localhost:27017/forgelocal

# ─── Authentication — Auth.js v5 ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-at-least-32-chars-long-here
AUTH_URL=http://localhost:3000

# ─── File Storage — Filebase (S3-compatible) ──────────────────────────────────
# Sign up at https://filebase.com
FILEBASE_ENDPOINT=https://s3.filebase.com
FILEBASE_BUCKET_NAME=forgelocal-dev
FILEBASE_ACCESS_KEY=your-filebase-access-key
FILEBASE_SECRET_KEY=your-filebase-secret-key
FILEBASE_REGION=us-east-1
# Optional: Public CDN URL for Filebase
# FILEBASE_PUBLIC_URL=https://your-bucket.s3.filebase.com

# ─── AI — Google Gemini ───────────────────────────────────────────────────────
# Get your API key at https://aistudio.google.com/apikey
# Leave blank to use mock provider in development
GOOGLE_GEMINI_API_KEY=
# "gemini" for production, "mock" for development (no AI key needed)
AI_PROVIDER=mock

# ─── Email (required for Phase 2+) ───────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@forgelocal.volcanic.world

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
