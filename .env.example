# OmniService AI — Environment Variables
# Copy this file to .env.local and fill in real values
# Never commit .env.local to version control

# ─── Application ──────────────────────────────────────────────────────────────
PORT=3012
NEXT_PUBLIC_APP_URL=http://localhost:3012
NEXT_PUBLIC_APP_NAME=OmniService AI

# ─── Database — MongoDB ───────────────────────────────────────────────────────
# For local development: mongodb://localhost:27017/omniservice
# For MongoDB Atlas:     mongodb+srv://<user>:<password>@<cluster>.mongodb.net/omniservice
MONGODB_URI=mongodb://localhost:27017/omniservice

# ─── Authentication — Auth.js v5 ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-at-least-32-chars-long-here
AUTH_URL=http://localhost:3012

# ─── File Storage — Filebase (S3-compatible) ──────────────────────────────────
# Sign up at https://filebase.com
FILEBASE_ENDPOINT=https://s3.filebase.com
FILEBASE_BUCKET_NAME=omniservice-dev
FILEBASE_ACCESS_KEY=your-filebase-access-key
FILEBASE_SECRET_KEY=your-filebase-secret-key
FILEBASE_REGION=us-east-1
# Optional: Public CDN URL for Filebase
# FILEBASE_PUBLIC_URL=https://your-bucket.s3.filebase.com

# ─── AI — Google Gemini ───────────────────────────────────────────────────────
# Get your API key at https://aistudio.google.com/apikey
# Leave blank to use mock provider in development
GOOGLE_GEMINI_API_KEY=
# "gemini" for production, "mock" for development (no AI key needed)
AI_PROVIDER=mock
# Free tier models: gemini-2.0-flash or gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash

# ─── Firebase Web App Configuration ──────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ─── Email (Volcanic Digital Solutions Gmail SMTP) ─────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=volcanic.digitalsolutions@gmail.com
SMTP_PASSWORD=wyyz jtmv rvkn xote
SMTP_FROM=volcanic.digitalsolutions@gmail.com

# ─── Support & Primary Contact ─────────────────────────────────────────────
NEXT_PUBLIC_SUPPORT_EMAIL=volcanic.digitalsolutions@gmail.com
NEXT_PUBLIC_SUPPORT_PHONE=+91 86248 51910

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
